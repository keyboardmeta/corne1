#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/* Layer definitions for Miryoku layout */

#define BASE   0
#define NAV    1
#define MOUSE  2
#define MEDIA  3
#define NUM    4
#define SYM    5
#define FUN    6

&sl {
    release-after-ms = <1000>;
    quick-release;  // <--- Just this line. No "tap".
};

/ {
    behaviors {
        /* Home Row Mods*/

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        /* Thumb layer keys */

        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };

        L4: L4 {
            compatible = "zmk,behavior-tap-dance";
            label = "L4";
            #binding-cells = <0>;
            bindings = <&sl 1>, <&to 1>;

            tapping-term-ms = <300>;
        };

        L1: L1 {
            compatible = "zmk,behavior-tap-dance";
            label = "L1";
            #binding-cells = <0>;
            bindings = <&sl 2>, <&to 2>;

            tapping-term-ms = <300>;
        };

        L2: L2 {
            compatible = "zmk,behavior-tap-dance";
            label = "L2";
            #binding-cells = <0>;
            bindings = <&sl 6>, <&to 6>;
        };

        L3: L3 {
            compatible = "zmk,behavior-tap-dance";
            label = "L3";
            #binding-cells = <0>;
            bindings = <&sl 4>, <&sl 4>;
        };

        L5: L5 {
            compatible = "zmk,behavior-tap-dance";
            label = "L5";
            #binding-cells = <0>;
            bindings = <&sl 3>, <&to 3>;
        };

        L6: L6 {
            compatible = "zmk,behavior-tap-dance";
            label = "L6";
            #binding-cells = <0>;
            bindings = <&sl 0>, <&to 0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        semicolon {
            bindings = <&kp SEMICOLON>;
            key-positions = <32 33>;
            layers = <0>;
        };

        Kpress {
            bindings = <&kp K>;
            key-positions = <31 32>;
            layers = <0>;
        };

        VPress {
            bindings = <&kp V>;
            key-positions = <27 28>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* Layer 0: BASE - Miryoku Colemak-DHm */

        default_layer {
            display-name = "VLayer";
            bindings = <
&kp TAB    &kp Q  &kp W       &kp F               &kp P           &kp B             &kp J  &kp L            &kp U                &kp Y       &kp SEMICOLON  &kp C_MUTE
&kp LCTRL  &kp A  &hm RALT R  &hm LEFT_CONTROL S  &hm LEFT_WIN T  &kp G             &kp M  &hm RIGHT_GUI N  &hm RIGHT_CONTROL E  &hm RALT I  &kp O          &kp C_VOL_UP
&kp ESC    &kp Z  &kp X       &kp C               &kp D           &kp V             &kp K  &kp H            &kp COMMA            &kp DOT     &kp FSLH       &kp C_VOL_DN
                              &kp ESC             &kp SPACE       &sk LEFT_SHIFT    &to 3  &sl 1            &to 2
            >;
        };

        symbollayer {
            display-name = "SymLayer";
            bindings = <
&none  &kp EXCLAMATION  &kp AT_SIGN    &kp HASH           &kp DOLLAR      &kp PRCNT         &kp BACKSLASH  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp ENTER        &to 4  &none
&none  &kp TILDE        &kp EQUAL      &kp DOUBLE_QUOTES  &kp SQT         &kp COLON         &kp SEMICOLON  &kp LEFT_BRACKET      &sk RIGHT_BRACKET      &kp TILDE        &to 5  &none
&none  &kp CARET        &kp AMPERSAND  &kp ASTERISK       &kp UNDERSCORE  &kp PIPE          &kp MINUS      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp EXCLAMATION  &to 6  &none
                                       &to 3              &to 0           &sk LEFT_SHIFT    &to 3          &to 1                 &to 2
            >;
        };

        num_layer {
            display-name = "NumLayer";
            bindings = <
&none  &none         &kp N7        &kp N8        &kp N9        &kp MINUS         &kp BSPC     &kp LC(V)     &kp LC(C)  &kp LC(X)  &kp LC(Z)  &none
&none  &kp PLUS      &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp N0            &kp LG(TAB)  &kp LEFT_GUI  &kp ENTER  &kp ESC    &kp TAB    &none
&none  &kp ASTERISK  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SLASH         &none        &none         &kp PG_DN  &kp PG_UP  &kp END    &none
                                   &trans        &to 0         &sk LEFT_SHIFT    &to 3        &to 1         &to 2
            >;
        };

        EditLayer {
            display-name = "NavLayer";
            bindings = <
&none  &none     &kp LCTRL  &none    &none     &none       &none         &none          &none      &none    &none    &none
&none  &kp TAB   &kp ESC    &kp RET  &kp BSPC  &kp HOME    &none         &kp BACKSPACE  &sk ENTER  &sk ESC  &kp TAB  &none
&none  &kp LALT  &kp LCTRL  &none    &none     &kp END     &none         &none          &none      &none    &none    &none
                            &trans   &to 0     &trans      &kp LEFT_GUI  &trans         &trans
            >;
        };

        media_layer {
            display-name = "Media";
            bindings = <
&bootloader  &none     &none     &none      &none      &none     &none   &none       &none         &none         &none       &none
&none        &kp LGUI  &kp RALT  &kp LCTRL  &kp LSHFT  &none     &none   &kp C_PREV  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT  &none
&none        &none     &none     &none      &none      &none     &none   &none       &none         &none         &none       &none
                                 &trans     &trans     &trans    &trans  &trans      &kp C_MUTE
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&none  &none     &none     &none      &none      &none     &kp LC(Y)  &kp LC(V)       &kp LC(C)       &kp LC(X)     &kp LC(Z)        &none
&none  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none     &none      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none
&none  &none     &none     &none      &none      &none     &none      &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none
                           &trans     &to 0      &trans    &trans     &trans          &trans
            >;
        };

        fun_layer {
            display-name = "Function";
            bindings = <
&none  &kp F12  &kp F7  &kp F8  &kp F9  &none     &none   &none      &none      &none     &none     &bootloader
&none  &kp F11  &kp F4  &kp F5  &kp F6  &none     &none   &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
&none  &kp F10  &kp F1  &kp F2  &kp F3  &none     &none   &none      &none      &none     &none     &none
                        &trans  &to 0   &trans    &trans  &trans     &trans
            >;
        };
    };
};
