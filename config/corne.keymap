#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/* Layer definitions for Miryoku layout */

#define BASE   0
#define NAV    1
#define MOUSE  2
#define MEDIA  3
#define NUM    4
#define SYM    5
#define FUN    6

&sl {
    release-after-ms = <1000>;
    quick-release;  // <--- Just this line. No "tap".
};

/ {
    behaviors {
        /* Home Row Mods*/

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        /* Thumb layer keys */

        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };

        L4: L4 {
            compatible = "zmk,behavior-tap-dance";
            label = "L4";
            #binding-cells = <0>;
            bindings = <&sl 1>, <&to 1>;

            tapping-term-ms = <300>;
        };

        L1: L1 {
            compatible = "zmk,behavior-tap-dance";
            label = "L1";
            #binding-cells = <0>;
            bindings = <&sl 2>, <&to 2>;

            tapping-term-ms = <300>;
        };

        L2: L2 {
            compatible = "zmk,behavior-tap-dance";
            label = "L2";
            #binding-cells = <0>;
            bindings = <&sl 6>, <&to 6>;
        };

        L3: L3 {
            compatible = "zmk,behavior-tap-dance";
            label = "L3";
            #binding-cells = <0>;
            bindings = <&sl 4>, <&sl 4>;
        };

        L5: L5 {
            compatible = "zmk,behavior-tap-dance";
            label = "L5";
            #binding-cells = <0>;
            bindings = <&sl 3>, <&to 3>;
        };

        L6: L6 {
            compatible = "zmk,behavior-tap-dance";
            label = "L6";
            #binding-cells = <0>;
            bindings = <&sl 0>, <&to 0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        semicolon {
            bindings = <&kp SEMICOLON>;
            key-positions = <32 33>;
            layers = <0>;
        };

        ToSym {
            bindings = <&to 1>;
            key-positions = <38 40>;
            layers = <0>;
        };

        ToNum {
            bindings = <&to 2>;
            key-positions = <38 41>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* Layer 0: BASE - Miryoku Colemak-DHm */

        default_layer {
            display-name = "VLayer";
            bindings = <
&kp TAB    &kp Q  &kp W       &kp F               &kp P      &kp B             &kp J         &kp L  &kp U                &kp Y       &kp SEMICOLON  &kp C_MUTE
&kp LCTRL  &kp A  &hm RALT R  &hm LEFT_CONTROL S  &kp T      &kp G             &kp M         &kp N  &hm RIGHT_CONTROL E  &hm RALT I  &kp O          &kp C_VOL_UP
&kp ESC    &kp Z  &kp X       &kp C               &kp D      &kp V             &kp K         &kp H  &kp COMMA            &kp DOT     &kp FSLH       &kp C_VOL_DN
                              &to 3               &kp SPACE  &sk LEFT_SHIFT    &sk LEFT_GUI  &sl 1  &sl 2
            >;
        };

        symbollayer {
            display-name = "SymLayer";
            bindings = <
&none  &kp EXCLAMATION  &kp AT_SIGN    &kp HASH           &kp DOLLAR      &kp PRCNT         &kp TAB    &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp NON_US_BACKSLASH  &none     &none
&none  &kp SEMICOLON    &kp EQUAL      &kp DOUBLE_QUOTES  &kp SQT         &kp TILDE         &kp COLON  &kp LEFT_BRACKET      &sk RIGHT_BRACKET      &kp MINUS             &kp PLUS  &none
&none  &kp CARET        &kp AMPERSAND  &kp ASTERISK       &kp UNDERSCORE  &kp PIPE          &kp SLASH  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp CARET             &to 6     &none
                                       &kp ESC            &to 0           &sk LEFT_SHIFT    &trans     &to 1                 &to 2
            >;
        };

        num_layer {
            display-name = "NumLayer";
            bindings = <
&none  &none         &kp N7        &kp N8        &kp N9        &kp MINUS         &kp LC(Y)     &kp LC(V)                &kp LC(C)  &kp LC(X)  &kp LC(Z)            &none
&none  &kp PLUS      &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp ASTERISK      &kp LG(TAB)   &mt (LEFT) LA(RS(LEFT))  &kp DOWN   &kp UP     &mt LA(RIGHT) RIGHT  &none
&none  &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp SLASH         &kp INSERT    &kp HOME                 &kp PG_DN  &kp PG_UP  &kp END              &none
                                   &trans        &to 0         &sk LEFT_SHIFT    &sk LEFT_GUI  &sl 1                    &to 2
            >;
        };

        NavLayer {
            display-name = "NavLayer";
            bindings = <
&none  &none     &none     &none   &none      &none       &none          &none          &none      &none     &none    &none
&none  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp HOME    &kp LG(ENTER)  &kp BACKSPACE  &sk RCTRL  &sk LALT  &kp ESC  &none
&none  &none     &none     &none   &none      &kp END     &none          &kp RET        &none      &none     &none    &none
                           &trans  &to 0      &trans      &trans         &trans         &trans
            >;
        };

        media_layer {
            display-name = "Media";
            bindings = <
&bootloader  &none     &none     &none      &none      &none     &none   &none       &none         &none         &none       &none
&none        &kp LGUI  &kp RALT  &kp LCTRL  &kp LSHFT  &none     &none   &kp C_PREV  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT  &none
&none        &none     &none     &none      &none      &none     &none   &none       &none         &none         &none       &none
                                 &trans     &trans     &trans    &trans  &trans      &kp C_MUTE
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&none  &none     &none     &none      &none      &none     &kp LC(Y)  &kp LC(V)       &kp LC(C)       &kp LC(X)     &kp LC(Z)        &none
&none  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none     &none      &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none
&none  &none     &none     &none      &none      &none     &none      &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none
                           &trans     &to 0      &trans    &trans     &trans          &trans
            >;
        };

        fun_layer {
            display-name = "Function";
            bindings = <
&none  &kp F12  &kp F7  &kp F8  &kp F9  &none     &none   &none      &none      &none     &none     &bootloader
&none  &kp F11  &kp F4  &kp F5  &kp F6  &none     &none   &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
&none  &kp F10  &kp F1  &kp F2  &kp F3  &none     &none   &none      &none      &none     &none     &none
                        &trans  &to 0   &trans    &trans  &trans     &trans
            >;
        };
    };
};
