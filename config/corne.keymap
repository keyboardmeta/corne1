#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/* Layer definitions for Miryoku layout */

#define BASE   0
#define NAV    1
#define MOUSE  2
#define MEDIA  3
#define NUM    4
#define SYM    5
#define FUN    6

&sl {
    release-after-ms = <1000>;
    quick-release;  // <--- Just this line. No "tap".
};

&sk { quick-release; };

/ {
    behaviors {
        /* Home Row Mods*/

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        /* Thumb layer keys */

        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        semicolon {
            bindings = <&kp SEMICOLON>;
            key-positions = <32 33>;
            layers = <0>;
        };

        Caps {
            bindings = <&kp CLCK>;
            key-positions = <36 41>;
        };

        QKey {
            bindings = <&kp Q>;
            key-positions = <2 3>;
        };

        PKey {
            bindings = <&kp P>;
            key-positions = <8 9>;
        };

        AltTap {
            bindings = <&kp LA(TAB)>;
            key-positions = <19 20 21>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* Layer 0: BASE - Miryoku Colemak-DHm */

        default_layer {
            display-name = "Thinh's Keyboard";
            bindings = <
&kp TAB    &kp Q  &kp W           &kp E               &kp R           &kp T          &kp Y              &kp U            &kp I                &kp O            &kp P     &kp C_MUTE
&kp LCTRL  &kp A  &hm LEFT_ALT S  &hm LEFT_CONTROL D  &hm LEFT_WIN F  &kp G          &kp H              &hm LEFT_WIN J   &hm RIGHT_CONTROL K  &hm L RIGHT_ALT  &kp SEMI  &kp C_VOL_UP
&kp ESC    &kp Z  &kp X           &kp C               &kp V           &kp B          &kp N              &kp M            &kp COMMA            &kp DOT          &kp FSLH  &kp C_VOL_DN
                                  &lt 4 ESC           &lt 5 SPACE     &lt 3 ENTER    &lt 1 RIGHT_SHIFT  &lt 2 BACKSPACE  &lt 6 TAB
            >;
        };

        Sym {
            display-name = "SymLayer";
            bindings = <
&none  &kp SINGLE_QUOTE  &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS   &kp LEFT_BRACKET     &none   &none     &none      &none     &none           &none
&none  &kp BACKSPACE     &kp DOLLAR       &kp PERCENT   &kp CARET              &kp RIGHT_BRACKET    &none   &kp LGUI  &kp RCTRL  &kp RALT  &kp LEFT_SHIFT  &none
&none  &kp PLUS          &kp EXCLAMATION  &kp AT_SIGN   &kp HASH               &kp BSLH             &none   &none     &none      &none     &none           &none
                                          &kp TILDE     &kp RIGHT_PARENTHESIS  &kp UNDERSCORE       &trans  &trans    &trans
            >;
        };

        Num {
            display-name = "Numlayer";
            bindings = <
&none  &none          &kp N7  &kp N8      &kp N9  &kp EQUAL       &none   &none         &none             &none         &none           &none
&none  &kp BACKSPACE  &kp N4  &kp N5      &kp N6  &kp ASTERISK    &none   &kp LEFT_GUI  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_SHIFT  &none
&none  &kp PLUS       &kp N1  &kp N2      &kp N3  &kp SLASH       &none   &none         &none             &none         &none           &none
                              &kp PERIOD  &kp N0  &kp MINUS       &trans  &trans        &trans
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&trans  &trans          &trans    &trans     &trans        &trans    &none   &none           &mkp LCLK       &mkp RCLK     &none            &trans
&trans  &kp LEFT_SHIFT  &kp LALT  &kp LCTRL  &kp LEFT_GUI  &trans    &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
&trans  &trans          &trans    &trans     &trans        &trans    &trans  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans
                                  &trans     &trans        &trans    &trans  &trans          &trans
            >;
        };

        media_layer {
            display-name = "Media";
            bindings = <
&bootloader  &none           &none     &none      &none         &none     &none   &kp C_PAUSE  &kp C_PREV    &kp C_NEXT    &none  &none
&none        &kp LEFT_SHIFT  &kp RALT  &kp LCTRL  &kp LEFT_GUI  &none     &none   &kp C_MUTE   &kp C_VOL_DN  &kp C_VOL_UP  &none  &none
&none        &none           &none     &none      &none         &none     &none   &none        &none         &none         &none  &none
                                       &trans     &trans        &trans    &trans  &kp C_PAUSE  &trans
            >;
        };

        NavLayer {
            bindings = <
&trans  &trans          &trans        &trans     &trans        &trans    &trans       &kp LS(PAGE_UP)  &kp UP    &kp PAGE_DOWN  &trans  &trans
&trans  &kp LEFT_SHIFT  &kp LEFT_ALT  &kp LCTRL  &kp LEFT_GUI  &trans    &kp LA(TAB)  &kp LEFT         &kp DOWN  &kp RIGHT      &trans  &trans
&trans  &trans          &trans        &trans     &trans        &trans    &trans       &kp HOME         &trans    &kp END        &trans  &trans
                                      &trans     &trans        &trans    &trans       &trans           &trans
            >;
        };

        fun_layer {
            display-name = "Function";
            bindings = <
&none  &kp F12  &kp F7  &kp F8  &kp F9  &none     &none   &none         &none      &none     &none           &bootloader
&none  &kp F11  &kp F4  &kp F5  &kp F6  &none     &none   &kp LEFT_GUI  &kp RCTRL  &kp RALT  &kp LEFT_SHIFT  &none
&none  &kp F10  &kp F1  &kp F2  &kp F3  &none     &none   &none         &none      &none     &none           &none
                        &trans  &trans  &trans    &trans  &trans        &trans
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
