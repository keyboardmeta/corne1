#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/* Layer definitions for Miryoku layout */

#define BASE   0
#define NAV    1
#define MOUSE  2
#define MEDIA  3
#define NUM    4
#define SYM    5
#define FUN    6

&sl {
    release-after-ms = <1000>;
    quick-release;  // <--- Just this line. No "tap".
};

&sk { quick-release; };

/ {
    behaviors {
        /* Home Row Mods*/

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        /* Thumb layer keys */

        lt: layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };

        L4: L4 {
            compatible = "zmk,behavior-tap-dance";
            label = "L4";
            #binding-cells = <0>;
            bindings = <&sl 1>, <&to 1>;

            tapping-term-ms = <300>;
        };

        L1: L1 {
            compatible = "zmk,behavior-tap-dance";
            label = "L1";
            #binding-cells = <0>;
            bindings = <&sl 2>, <&to 2>;

            tapping-term-ms = <300>;
        };

        L2: L2 {
            compatible = "zmk,behavior-tap-dance";
            label = "L2";
            #binding-cells = <0>;
            bindings = <&sl 6>, <&to 6>;
        };

        L3: L3 {
            compatible = "zmk,behavior-tap-dance";
            label = "L3";
            #binding-cells = <0>;
            bindings = <&sl 5>, <&sl 5>;
        };

        L5: L5 {
            compatible = "zmk,behavior-tap-dance";
            label = "L5";
            #binding-cells = <0>;
            bindings = <&sl 3>, <&to 3>;
        };

        L6: L6 {
            compatible = "zmk,behavior-tap-dance";
            label = "L6";
            #binding-cells = <0>;
            bindings = <&sl 0>, <&to 0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        semicolon {
            bindings = <&kp SEMICOLON>;
            key-positions = <32 33>;
            layers = <0>;
        };

        Kpress {
            bindings = <&kp K>;
            key-positions = <31 32>;
            layers = <0>;
        };

        VPress {
            bindings = <&kp V>;
            key-positions = <27 28>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* Layer 0: BASE - Miryoku Colemak-DHm */

        default_layer {
            display-name = "VLayer";
            bindings = <
&kp TAB    &kp Q  &kp W       &kp F               &kp P           &kp B             &kp J  &kp L            &kp U                &kp Y       &kp SEMICOLON  &kp C_MUTE
&kp LCTRL  &kp A  &hm RALT R  &hm LEFT_CONTROL S  &hm LEFT_WIN T  &kp G             &kp M  &hm RIGHT_GUI N  &hm RIGHT_CONTROL E  &hm RALT I  &kp O          &kp C_VOL_UP
&kp ESC    &kp Z  &kp X       &kp C               &kp D           &kp V             &kp K  &kp H            &kp COMMA            &kp DOT     &kp FSLH       &kp C_VOL_DN
                              &kp ESC             &kp SPACE       &sk LEFT_SHIFT    &to 3  &sl 1            &to 2
            >;
        };

        symbollayer {
            display-name = "SymLayer";
            bindings = <
&none  &kp EXCLAMATION  &kp AT_SIGN    &kp HASH           &kp DOLLAR      &kp PRCNT         &kp PLUS              &kp MINUS      &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &to 5  &none
&none  &kp TILDE        &kp EQUAL      &kp DOUBLE_QUOTES  &kp SQT         &kp QUESTION      &kp COLON             &kp SEMICOLON  &sk LEFT_BRACE        &kp RIGHT_BRACE        &to 4  &none
&none  &kp CARET        &kp AMPERSAND  &kp ASTERISK       &kp UNDERSCORE  &kp PIPE          &kp NON_US_BACKSLASH  &kp SLASH      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &to 6  &none
                                       &trans             &to 0           &sk LEFT_SHIFT    &to 3                 &to 1          &to 2
            >;
        };

        num_layer {
            display-name = "NumLayer";
            bindings = <
&none  &none         &kp N7                 &kp N8        &kp N9                 &kp MINUS           &kp LG(D)    &hm LC(RS(V)) LC(V)  &kp LC(C)               &kp LG(ENTER)           &kp LC(A)  &none
&none  &kp PLUS      &hm LEFT_ALT NUMBER_4  &hm LCTRL N5  &hm LEFT_WIN NUMBER_6  &kp N0              &kp LG(TAB)  &hm RIGHT_GUI LEFT   &hm RIGHT_CONTROL DOWN  &hm RIGHT_ALT UP_ARROW  &kp RIGHT  &none
&none  &kp ASTERISK  &kp NUMBER_1           &kp NUMBER_2  &kp NUMBER_3           &kp SLASH           &none        &kp HOME             &kp PG_DN               &kp PG_UP               &kp END    &none
                                            &trans        &to 0                  &lt 4 LEFT_SHIFT    &to 3        &to 1                &to 2
            >;
        };

        EditLayer {
            display-name = "NavLayer";
            bindings = <
&none  &none    &none    &none    &none     &none     &none   &none          &none      &none    &none    &none
&none  &kp TAB  &kp ESC  &kp RET  &kp BSPC  &none     &none   &kp BACKSPACE  &sk ENTER  &sk ESC  &kp TAB  &none
&none  &kp END  &none    &none    &kp HOME  &none     &none   &kp HOME       &none      &none    &kp END  &none
                         &trans   &to 0     &trans    &trans  &trans         &trans
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&trans  &trans    &trans    &trans     &trans     &trans    &none   &none           &mkp LCLK       &mkp RCLK     &none            &trans
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans    &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
&trans  &trans    &trans    &trans     &trans     &trans    &trans  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &trans
                            &trans     &to 0      &trans    &trans  &trans          &trans
            >;
        };

        media_layer {
            display-name = "Media";
            bindings = <
&bootloader  &none     &none     &none      &none      &none     &none   &none       &none         &none         &none       &none
&none        &kp LGUI  &kp RALT  &kp LCTRL  &kp LSHFT  &none     &none   &kp C_PREV  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT  &none
&none        &none     &none     &none      &none      &none     &none   &none       &none         &none         &none       &none
                                 &trans     &to 0      &trans    &trans  &trans      &trans
            >;
        };

        fun_layer {
            display-name = "Function";
            bindings = <
&none  &kp F12  &kp F7  &kp F8  &kp F9  &none     &none   &none      &none      &none     &none     &bootloader
&none  &kp F11  &kp F4  &kp F5  &kp F6  &none     &none   &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
&none  &kp F10  &kp F1  &kp F2  &kp F3  &none     &none   &none      &none      &none     &none     &none
                        &trans  &to 0   &trans    &trans  &trans     &trans
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
